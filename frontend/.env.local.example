# ── NEDB environment ────────────────────────────────────────────────────────
# Copy to .env.local and fill in. Never commit .env.local.
#
# The application reads exactly these variables. Anything absent degrades a
# specific feature rather than failing at boot, which is convenient in
# development and dangerous in production, so the "what breaks" note on each one
# matters: a missing value is silent.
#
# Check what is actually live with GET /api/health, which probes each
# dependency rather than asserting it is fine.

# ── Required. The app does not work without these. ──────────────────────────

# Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Service role key. This BYPASSES row-level security, so it is the master
# credential for the database. Server-side only: it must never be exposed to
# the browser and there is deliberately no NEXT_PUBLIC_ variant.
SUPABASE_SERVICE_ROLE_KEY=

# Signing secrets for the 15 minute access token and the 7 day refresh token.
# Use two DIFFERENT long random strings, e.g. `openssl rand -base64 48`.
# Rotating these signs everyone out, which is the intended effect after a leak.
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Strongly recommended in production ──────────────────────────────────────

# Upstash Redis, used for response caching and for durable rate limiting across
# serverless instances.
# What breaks without it: caching is off, so every request hits the database,
# and rate limiting falls back to a per-instance limiter which is weaker across
# instances but still enforced. It does NOT fail open.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared secret for scheduled jobs. Vercel Cron sends it as
# `Authorization: Bearer <CRON_SECRET>`.
# What breaks without it: every cron route refuses to run, so the monthly brief,
# the annual pull and the signals job silently never fire. This is fail-closed
# by design; an unauthenticated job that writes records would be worse.
CRON_SECRET=

# Transactional email (Resend). Used for the monthly report, subscriber
# broadcasts, access-request notifications and assessment verification links.
# What breaks without it: nothing sends, and delivery counts report zero.
# Note: an unverified Resend domain only delivers to the account owner.
RESEND_API_KEY=

# Absolute origin, e.g. https://nedb.vercel.app. Used to build links in email
# and share previews. Without it, links in outbound mail may be relative.
NEXT_PUBLIC_BASE_URL=

# ── Optional features. Absent means the feature is off, not broken. ─────────

# API key for the IoT/telemetry ingest endpoint, presented as `X-API-Key`.
# Without it, /api/iot/ingest refuses every request and reports itself as
# not-configured.
IOT_API_KEY=

# Google Gemini, used by the Apex AI assistant and the knowledge graph answers.
# Without it, those surfaces report that the assistant is unavailable.
GEMINI_API_KEY=

# Google Places, used to improve address autocomplete in assessments.
# Without it, geocoding falls back to OpenStreetMap Nominatim, which is free and
# needs no key. Places requires billing to be enabled on the Google project.
GOOGLE_MAPS_API_KEY=

# Google Sign-In client ID for the public assessment form.
# Without it, the form falls back to a typed email address with an MX check.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# The site's own public origin, used to build the confirmation links that go
# out in assessment verification emails. Set this in production: without it the
# link is built from the request's Host header, which is a link an attacker can
# aim, sent over NEDB's own mail. Read at request time, so changing it when a
# custom domain lands needs no rebuild. No trailing slash.
SITE_ORIGIN=https://nedb.vercel.app

# ── Database migrations ─────────────────────────────────────────────────────
# Not read by the application. Used by scripts/migrate.mjs only, and normally
# passed on the command line rather than stored here:
#
#   DATABASE_URL=postgres://... node scripts/migrate.mjs status
#
# This is the session pooler connection string from the Supabase dashboard.
# DATABASE_URL=
